  "fixed_sql": [
    {
      "name": "stores",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stores\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"vat_number\" TEXT NULL UNIQUE, \"address\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE, \"icon\" TEXT NOT NULL DEFAULT 'category', \"color\" INTEGER NOT NULL DEFAULT 4288585374, \"parent_id\" INTEGER NULL REFERENCES categories (id));"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"canonical_name\" TEXT NOT NULL UNIQUE, \"category_id\" INTEGER NULL REFERENCES categories (id), \"unit\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "product_aliases",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"product_aliases\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"raw_name\" TEXT NOT NULL UNIQUE, \"product_id\" INTEGER NOT NULL REFERENCES products (id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "category_keywords",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"category_keywords\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"keyword\" TEXT NOT NULL UNIQUE, \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "receipts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"receipts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"store_id\" INTEGER NULL REFERENCES stores (id), \"purchase_date\" INTEGER NOT NULL, \"total_cents\" INTEGER NOT NULL, \"discount_cents\" INTEGER NOT NULL DEFAULT 0, \"source_path\" TEXT NULL, \"raw_ocr_text\" TEXT NULL, \"status\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "receipt_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"receipt_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"receipt_id\" INTEGER NOT NULL REFERENCES receipts (id) ON DELETE CASCADE, \"product_id\" INTEGER NULL REFERENCES products (id), \"raw_name\" TEXT NOT NULL, \"quantity\" REAL NOT NULL DEFAULT 1.0, \"unit_price_cents\" INTEGER NOT NULL, \"line_total_cents\" INTEGER NOT NULL, \"discount_cents\" INTEGER NOT NULL DEFAULT 0, \"category_id\" INTEGER NULL REFERENCES categories (id));"
        }
      ]
    }
  ]
}